<Window x:Class="TaskRecorder.Views.TodayTasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:TaskRecorder.Models"
        Title="今日任务"
        Width="400" Height="500"
        MinWidth="250" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing">

    <Grid Margin="8">
        <ListBox x:Name="TodayListBox"
                 ItemsSource="{Binding}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type m:TaskItem}">
                    <TextBlock Text="{Binding Title}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                        <Setter Property="Foreground" Value="#999"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="删除" Click="DeleteMenuItem_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </Grid>
</Window>
