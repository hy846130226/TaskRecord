<Window x:Class="TaskRecorder.Views.MilestoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Milestone"
        Width="320" Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" Margin="0,0,0,10"
                   Text="里程碑天数（从创建日起）:"/>

        <TextBox x:Name="DaysBox" Grid.Row="1"
                 PreviewTextInput="DaysBox_PreviewTextInput"
                 KeyDown="DaysBox_KeyDown"/>

        <TextBlock x:Name="ErrorText" Grid.Row="2"
                   Foreground="Red" FontSize="11" Margin="0,4,0,0"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="清除" Width="60" Margin="0,0,8,0"
                    Click="ClearButton_Click"/>
            <Button Content="取消" Width="60" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="确认" Width="60" IsDefault="True"
                    Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
